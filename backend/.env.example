# Abiqua Collection Voice RAG — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=<your-database-name>
MONGODB_COLLECTION=firearms
MONGODB_VECTOR_INDEX=<your-vector-search-index-name>
MONGODB_EMBEDDING_FIELD=embedding

# OpenAI (embeddings)
OPENAI_API_KEY=sk-...
LLAMAINDEX_EMBED_MODEL=text-embedding-3-small

# Anthropic (LLM narration)
ANTHROPIC_API_KEY=sk-ant-...

# Rime TTS
RIME_API_KEY=<your-rime-api-key>
RIME_BASE_URL=https://users-west.rime.ai
RIME_DEFAULT_VOICE=abbie
RIME_DEFAULT_MODEL=mist

# Set true locally to put exception messages in JSON error responses (never enable in prod).
EXPOSE_INTERNAL_ERRORS=false

# Image serving
IMAGE_BASE_URL=https://theabiquacollection.com/images

# Application
LOG_LEVEL=INFO
# When true: stderr shows [pipeline] INFO lines for /voices, retrieval, Rime, /query timings.
PIPELINE_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173
